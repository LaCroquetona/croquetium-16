@8      //PRIMER NUMERO
-A=>B   //PON -A O A DEPENDIENDO DE SI QUIERES QUE SEA NEGATIVO O POSITIVO
@X
B=>M
@4      //SEGUNDO NUMERO
-A=>B   //PON -A O A DEPENDIENDO DE SI QUIERES QUE SEA NEGATIVO O POSITIVO
@Y
B=>M
@X
M=>B
@R    
0=>M    //INICIALIZA R
PC+1=>C
@R
B+M=>M
@Y
M-1=>M>=0
@FIN
PC+1=>C
@R
M-B=>M
@Y
M+1=>M!=0
(FIN)
PARA


