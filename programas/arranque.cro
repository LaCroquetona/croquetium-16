// la croqueta gira: cada vuelta borra su casilla y pinta la posición siguiente (0xBC a 0xBF)
(GIRA)
// croqueta: fila 18, columna 14
@32767
A+1 => B
@2887           // 18 * 160 + 14 / 2
A+B => B
@sitio
B => M
@30720          // 0x7800, fuente izquierda
A => B
@fuente
B => M
@BORRA
A => C
VUELVE
@paso
M+1 => M
M => B
@3
A&B => B
@0xBC
A+B => B        // B = 0xBC + (paso & 3)
@PON
A => C
VUELVE
@20000          // espera: más grande, gira más lento
PC+1 => C
A-1 => A >0
@GIRA
A => C
jmp

(PON)
2B => B
2B => B
2B => B         // B = letra * 8
@fuente
M+B => B        // B = dónde empieza la letra en la fuente
@fila
B => M
@8
A => B
@cuenta
B => M
@sitio
M => B          // B = palabra de pantalla de la fila de arriba
(PON_FILA)
@fila
M+1 => M
M-1 => A        // A = fila de la letra
M|N => N        // se junta con la otra letra de la palabra
@20
A+B => B        // fila de pantalla de abajo
@PON_FILA
A => C
@cuenta
M-1 => M >0
// avanza: de la izquierda pasa a la derecha de la misma palabra; de la derecha, a la izquierda de la siguiente
@PON_ERA_DERECHA
A => C
@30720
A => B
@fuente
M-B !=0
@28672          // 0x7000, fuente derecha
A => B
@fuente
B => M
RETORNA
(PON_ERA_DERECHA)
@30720
A => B
@fuente
B => M
@sitio
M+1 => M
RETORNA

(BORRA)
@8
A => B
@cuenta
B => M
@sitio
M => B
(BORRA_FILA)
0 => N
@20
A+B => B
@BORRA_FILA
A => C
@cuenta
M-1 => M >0
RETORNA
