// Pantalla de arranque de Croquetium OS en 320x240.
// Necesita la fuente en M (casilla "Fuente en M" del IDE) y la pestaña Pantalla en 320x240.
// Texto de 40 columnas x 30 filas. Una columna par va en la mitad izquierda de su palabra
// de pantalla (fuente 0x7800) y una impar en la derecha (fuente 0x7000).
// PON pinta la letra que hay en B donde dicen sitio y fuente, y avanza una columna.

// borra la pantalla: la RAM real arranca con basura
@32767
A+1 => B        // B = 0x8000
@4800
PC+1 => C
0 => N
B+1 => B
A-1 => A >0

// logo, mitad de arriba: fila 11, columna 19
@32767
A+1 => B
@1769           // 11 * 160 + 19 / 2
A+B => B
@sitio
B => M
@28672          // 0x7000, fuente derecha
A => B
@fuente
B => M
@0xB8       // logo arriba-izq
A => B
@PON
A => C
VUELVE
@0xB9       // logo arriba-der
A => B
@PON
A => C
VUELVE

// logo, mitad de abajo: fila 12, columna 19
@32767
A+1 => B
@1929           // 12 * 160 + 19 / 2
A+B => B
@sitio
B => M
@28672          // 0x7000, fuente derecha
A => B
@fuente
B => M
@0xBA       // logo abajo-izq
A => B
@PON
A => C
VUELVE
@0xBB       // logo abajo-der
A => B
@PON
A => C
VUELVE

// nombre: fila 15, columna 13
@32767
A+1 => B
@2406           // 15 * 160 + 13 / 2
A+B => B
@sitio
B => M
@28672          // 0x7000, fuente derecha
A => B
@fuente
B => M
@0x63       // c
A => B
@PON
A => C
VUELVE
@0x72       // r
A => B
@PON
A => C
VUELVE
@0x6F       // o
A => B
@PON
A => C
VUELVE
@0x71       // q
A => B
@PON
A => C
VUELVE
@0x75       // u
A => B
@PON
A => C
VUELVE
@0x65       // e
A => B
@PON
A => C
VUELVE
@0x74       // t
A => B
@PON
A => C
VUELVE
@0x69       // i
A => B
@PON
A => C
VUELVE
@0x75       // u
A => B
@PON
A => C
VUELVE
@0x6D       // m
A => B
@PON
A => C
VUELVE
@0x20       // espacio
A => B
@PON
A => C
VUELVE
@0x6F       // o
A => B
@PON
A => C
VUELVE
@0x73       // s
A => B
@PON
A => C
VUELVE

// cargando: fila 18, columna 16
@32767
A+1 => B
@2888           // 18 * 160 + 16 / 2
A+B => B
@sitio
B => M
@30720
A => B
@fuente
B => M
@0x63       // c
A => B
@PON
A => C
VUELVE
@0x61       // a
A => B
@PON
A => C
VUELVE
@0x72       // r
A => B
@PON
A => C
VUELVE
@0x67       // g
A => B
@PON
A => C
VUELVE
@0x61       // a
A => B
@PON
A => C
VUELVE
@0x6E       // n
A => B
@PON
A => C
VUELVE
@0x64       // d
A => B
@PON
