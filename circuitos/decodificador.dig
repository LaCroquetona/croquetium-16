<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry><string>Description</string><string>Decodificador: corta la instrucción en campos y arma la palabra de control (34 bits) que va por arriba a todos los bloques. Con el bit 15 a 1 (número) bloquea D y J. Decide qué carga A (selA: 0 cima de R, 1 número, 2 tecla, 3 RES) y si se escriben A y C. Los 16 cables de sistema pasan tal cual.</string></entry>
    <entry><string>shapeType</string><shapeType>LAYOUT</shapeType></entry>
    <entry><string>Width</string><int>10</int></entry>
    <entry><string>Height</string><int>10</int></entry>
  </attributes>
  <visualElements>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>esALU</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="60"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>cables</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="0" y="140"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>INS</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="0" y="480"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>control</string></entry><entry><string>Bits</string><int>34</int></entry></elementAttributes><pos x="1200" y="60"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>NUM</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="1200" y="780"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Qué carga A: número (bit 15), tecla (A-TECLA) o cima de R (A-R).
A se escribe con D0 o si carga algo que no es RES (selA &lt; 3).</string></entry></elementAttributes><pos x="160" y="-80"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Con un número (bit 15 = 1), D y J valen 0</string></entry></elementAttributes><pos x="160" y="840"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>NUM: los 15 bits de abajo</string></entry></elementAttributes><pos x="660" y="800"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Palabra
de control</string></entry></elementAttributes><pos x="1060" y="100"/></visualElement>
