<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes><entry><string>Description</string><string>Pila de retornos R: 16 casillas de 17 bits (vuelta + banco) y un contador de 4 bits (SP) que apunta a la primera libre. Apilar escribe en SP y sube; desapilar baja. La cima es SP-1. Con 16 llenas, apilar pisa la más vieja porque el contador da la vuelta.</string></entry></attributes>
  <visualElements>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>vuelta</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="0" y="0"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>banco</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="60"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>apila</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="120"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>desapila</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="180"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>Clk</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="240"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="320"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="0" y="380"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>15</long></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="0" y="440"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>SP: sube al apilar, baja al desapilar</string></entry></elementAttributes><pos x="260" y="-60"/></visualElement>
    <visualElement><elementName>Or</elementName><elementAttributes></elementAttributes><pos x="260" y="0"/></visualElement>
    <visualElement><elementName>CounterPreset</elementName><elementAttributes><entry><string>Bits</string><int>4</int></entry><entry><string>Label</string><string>SP</string></entry></elementAttributes><pos x="480" y="0"/></visualElement>
    <visualElement><elementName>Add</elementName><elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="480" y="220"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>16 casillas de 17 bits</string></entry></elementAttributes><pos x="760" y="-60"/></visualElement>
    <visualElement><elementName>Splitter</elementName><elementAttributes><entry><string>Input Splitting</string><string>16,1</string></entry><entry><string>Output Splitting</string><string>17</string></entry></elementAttributes><pos x="760" y="0"/></visualElement>
    <visualElement><elementName>RegisterFile</elementName><elementAttributes><entry><string>Bits</string><int>17</int></entry><entry><string>AddrBits</string><int>4</int></entry><entry><string>Label</string><string>pila</string></entry></elementAttributes><pos x="960" y="0"/></visualElement>
    <visualElement><elementName>Splitter</elementName><elementAttributes><entry><string>Input Splitting</string><string>17</string></entry><entry><string>Output Splitting</string><string>16,1</string></entry></elementAttributes><pos x="1220" y="0"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>cima</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="1460" y="0"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>cimaBanco</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="1460" y="60"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>SP</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="1460" y="120"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>apilar y desapilar</string></entry><entry><string>Testdata</string><testData><dataString>Clk vuelta banco apila desapila cima cimaBanco
