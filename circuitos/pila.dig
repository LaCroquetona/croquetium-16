<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry><string>Description</string><string>Pila de retornos R: 16 casillas de 17 bits (vuelta + banco) y un contador de 4 bits (SP) que apunta a la primera libre. Apilar (GUARDA-R) escribe en SP y sube; desapilar (SALTO-R o A-R) baja. La cima es SP-1. Con 16 llenas, apilar pisa la más vieja porque el contador da la vuelta.</string></entry>
    <entry><string>shapeType</string><shapeType>LAYOUT</shapeType></entry>
    <entry><string>Width</string><int>14</int></entry>
    <entry><string>Height</string><int>8</int></entry>
  </attributes>
  <visualElements>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>A-R</string></entry><entry><string>Bits</string><int>1</int></entry><entry><string>rotation</string><rotation rotation="3"/></entry></elementAttributes><pos x="260" y="0"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>SALTO-R</string></entry><entry><string>Bits</string><int>1</int></entry><entry><string>rotation</string><rotation rotation="3"/></entry></elementAttributes><pos x="320" y="0"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>GUARDA-R</string></entry><entry><string>Bits</string><int>1</int></entry><entry><string>rotation</string><rotation rotation="3"/></entry></elementAttributes><pos x="520" y="0"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>vuelta</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="0" y="140"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>banco</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="200"/></visualElement>
    <visualElement><elementName>Clock</elementName><elementAttributes><entry><string>Label</string><string>Clk</string></entry><entry><string>rotation</string><rotation rotation="1"/></entry></elementAttributes><pos x="640" y="660"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>cima</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes><pos x="1320" y="140"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>cimaBanco</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="1320" y="200"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>SP</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="1320" y="520"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Se apila la vuelta
y su banco (17 bits)</string></entry></elementAttributes><pos x="20" y="60"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>SP sube al apilar
y baja al desapilar</string></entry></elementAttributes><pos x="360" y="460"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>La cima es SP-1</string></entry></elementAttributes><pos x="980" y="400"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>16 casillas</string></entry></elementAttributes><pos x="1000" y="280"/></visualElement>
    <visualElement><elementName>Splitter</elementName><elementAttributes><entry><string>Input Splitting</string><string>16,1</string></entry><entry><string>Output Splitting</string><string>17</string></entry></elementAttributes><pos x="120" y="140"/></visualElement>
    <visualElement><elementName>Or</elementName><elementAttributes></elementAttributes><pos x="360" y="240"/></visualElement>
    <visualElement><elementName>Or</elementName><elementAttributes></elementAttributes><pos x="560" y="200"/></visualElement>
    <visualElement><elementName>CounterPreset</elementName><elementAttributes><entry><string>Bits</string><int>4</int></entry><entry><string>Label</string><string>SP</string></entry></elementAttributes><pos x="700" y="300"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="680" y="360"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>0</long></entry></elementAttributes><pos x="660" y="400"/></visualElement>
    <visualElement><elementName>Add</elementName><elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="840" y="420"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>15</long></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes><pos x="820" y="440"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>0</long></entry></elementAttributes><pos x="820" y="460"/></visualElement>
    <visualElement><elementName>RegisterFile</elementName><elementAttributes><entry><string>Bits</string><int>17</int></entry><entry><string>AddrBits</string><int>4</int></entry><entry><string>Label</string><string>pila</string></entry></elementAttributes><pos x="1000" y="140"/></visualElement>
    <visualElement><elementName>Splitter</elementName><elementAttributes><entry><string>Input Splitting</string><string>17</string></entry><entry><string>Output Splitting</string><string>16,1</string></entry></elementAttributes><pos x="1160" y="140"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>apilar y desapilar</string></entry><entry><string>Testdata</string><testData><dataString>Clk vuelta banco GUARDA-R SALTO-R A-R cima cimaBanco
