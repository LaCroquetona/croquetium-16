<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry><string>Description</string><string>Reloj al estilo de Ben Eater: automático (Clk) o paso a paso (botón paso), según el interruptor manual. PARA lo detiene, como su HLT: se guarda en un biestable en el flanco de bajada (con el reloj ya en 0), así un pico de PARA mientras cambia la instrucción no puede colar un flanco de más (solo para si además PARA sigue a 1). reset deja pasar el reloj para volver a empezar. En la protoboard serían tres 555 y unas puertas.</string></entry>
    <entry><string>shapeType</string><shapeType>LAYOUT</shapeType></entry>
    <entry><string>Width</string><int>8</int></entry>
    <entry><string>Height</string><int>7</int></entry>
  </attributes>
  <visualElements>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>PARA</string></entry><entry><string>Bits</string><int>1</int></entry><entry><string>rotation</string><rotation rotation="3"/></entry></elementAttributes><pos x="420" y="0"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>reset</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="100"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>Clk</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="240"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>paso</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="320"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>manual</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="0" y="400"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>CLK</string></entry><entry><string>Bits</string><int>1</int></entry></elementAttributes><pos x="1000" y="240"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Automático o paso a paso
(manual = 1)</string></entry></elementAttributes><pos x="40" y="440"/></visualElement>
    <visualElement><elementName>Text</elementName><elementAttributes><entry><string>Description</string><string>Para si PARA sigue a 1 tras bajar el reloj;
reset lo vuelve a arrancar</string></entry></elementAttributes><pos x="500" y="20"/></visualElement>
    <visualElement><elementName>Multiplexer</elementName><elementAttributes></elementAttributes><pos x="200" y="240"/></visualElement>
    <visualElement><elementName>Not</elementName><elementAttributes></elementAttributes><pos x="340" y="180"/></visualElement>
    <visualElement><elementName>Register</elementName><elementAttributes><entry><string>Bits</string><int>1</int></entry><entry><string>Label</string><string>parado</string></entry></elementAttributes><pos x="440" y="140"/></visualElement>
    <visualElement><elementName>Const</elementName><elementAttributes><entry><string>Value</string><long>1</long></entry></elementAttributes><pos x="420" y="180"/></visualElement>
    <visualElement><elementName>NAnd</elementName><elementAttributes></elementAttributes><pos x="560" y="140"/></visualElement>
    <visualElement><elementName>Or</elementName><elementAttributes></elementAttributes><pos x="700" y="120"/></visualElement>
    <visualElement><elementName>And</elementName><elementAttributes></elementAttributes><pos x="800" y="220"/></visualElement>
