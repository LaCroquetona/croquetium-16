<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry><string>Description</string><string>ALU de Croquetium 16. La ROM de la ALU traduce la operación O (5 bits) a las 8 señales del núcleo; las operaciones 08, 0A, 0C y 0E dividen entre 2 (O3 = 1, O4 = 0 y O0 = 0). Abajo, los biestables de estado: carry (se guarda en cada operación de ALU), rotar y encadenar (se encienden y apagan con instrucciones de sistema). cin = carry si encadenar.</string></entry>
    <entry><string>shapeType</string><shapeType>LAYOUT</shapeType></entry>
    <entry><string>Width</string><int>16</int></entry>
    <entry><string>Height</string><int>12</int></entry>
