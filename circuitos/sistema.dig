<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry><string>Description</string><string>Instrucciones de sistema. Con el bit 15 a 0 y D = J = 0 una instrucción de ALU no haría nada: esos 128 códigos (bits 8 a 14) son de sistema. La ROM de sistema (sistema.json) traduce el código a 16 cables. Si no es de sistema, la ROM lee la dirección 0 (NOP): todos los cables a 0. esALU vale 1 en las instrucciones de ALU de verdad (para el carry).</string></entry>
    <entry><string>shapeType</string><shapeType>LAYOUT</shapeType></entry>
    <entry><string>Width</string><int>10</int></entry>
    <entry><string>Height</string><int>6</int></entry>
  </attributes>
